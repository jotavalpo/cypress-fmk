{
  "name": "cypress-fmk",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "limpiar-reporte": "rimraf ./allure-report && rimraf ./allure-results",
    "ejecutar-todas-las-pruebas": "cypress run --headed --env allure=true",
    "ejecutar-casos-de-prueba-api": "cypress run --headed --env allure=true --spec \"cypress/e2e/api/*.cy.js",
    "ejecutar-casos-de-prueba-web": "cypress run --headed --env allure=true --spec \"cypress/e2e/tests/catalogo-y-compras.cy.js",
    "generar-reporte": "allure generate allure-results -o allure-report --clean",
    "abrir-reporte": "allure open",
    "test-api": "npm run limpiar-reporte && npm run ejecutar-casos-de-prueba-api & npm run generar-reporte && npm run abrir-reporte",
    "test-web": "npm run limpiar-reporte && npm run ejecutar-casos-de-prueba-web & npm run generar-reporte && npm run abrir-reporte",
    "probar-todo": "npm run limpiar-reporte && npm run ejecutar-todas-las-pruebas & npm run generar-reporte && npm run abrir-reporte"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "allure-commandline": "^2.27.0",
    "cypress-parallel": "^0.14.0",
    "cypress-plugin-api": "^2.11.2"
  },
  "devDependencies": {
    "@shelex/cypress-allure-plugin": "^2.40.2",
    "cypress": "^12.13.0",
    "rimraf": "^5.0.5"
  }
}
