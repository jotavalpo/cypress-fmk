{
  "name": "cypress-fmk",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "limpiar-reporte": "rimraf ./allure-report && rimraf ./allure-results",
    "ejecutar-pruebas-web": "cypress run --headed --env allure=true",
    "ejecutar-pruebas-api": "cypress run --headed --env allure=true --spec cypress/e2e/api",
    "generar-reporte": "allure generate allure-results -o allure-report --clean",
    "abrir-reporte": "allure open",
    "test-web": "npm run limpiar-reporte && npm run ejecutar-pruebas-web & npm run generar-reporte && npm run abrir-reporte",
    "test-api": "npm run limpiar-reporte && npm run ejecutar-pruebas-api & npm run generar-reporte && npm run abrir-reporte"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "allure-commandline": "^2.27.0",
    "cypress-parallel": "^0.14.0",
    "cypress-plugin-api": "^2.11.2"
  },
  "devDependencies": {
    "@shelex/cypress-allure-plugin": "^2.40.2",
    "cypress": "^12.13.0",
    "cypress-cucumber-preprocessor": "^4.3.1",
    "rimraf": "^5.0.5"
  },
  "cypress-cucumber-preprocessor": {
    "nonGlobalStepDefinitions": false,
    "stepDefinitions": "cypress/integration/stepDefinitions"
  }
}
